@startuml

class Sistema {
   + Sistema()
   - listaAnimales : ArrayList<Animal>
   - listaFamilias : ArrayList<Familia>
   - listaEmpresas : ArrayList<Empresa>
   - listaAdopciones : ArrayList<Adopcion>
   - listaDonaciones : ArrayList<Donacion>
   + registrarAnimal(String, String, int) : void
   + registrarFamilia(String, String, int) : void
   + registrarEmpresa(String, int, String) : void
   + registrarAdopcion(Animal,Familia) : void
   + registrarDonacion(Empresa, int, int) : void
   + anularAdopcion(Adopcion) : void
   + importarDonaciones() : void
}

class Animal {
   + Animal(String, int, String, int, String)
   - nombre : String
   - codigo : int
   - temperamento : String
   - peso : int
   - estado : String
   + cambiarEstado() : void
}

class Familia {
   + Familia(String, String, int)
   - cedulaTitular : String
   - apellido : String
   - celular : int
}

class Empresa {
   + Empresa(String, int, String)
   - nombre : String
   - rut : int
   - direccion : String
}

class Adopcion {
   + Adopcion(Animal, Familia)
   - animal : Animal
   - familia : Familia
}

class Donacion {
   + Donacion(Empresa, int, int)
   - empresaDonante : Empresa
   - tipoAlimento : int
   - kilos : int
   - codigo : int
}

Animal --* Sistema
Familia --* Sistema
Empresa --* Sistema
Adopcion --* Sistema
Donacion --* Sistema
Adopcion --> Animal
Adopcion --> Familia
Donacion --> Empresa
@enduml
