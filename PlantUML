@startuml
class Sistema {
   + Sistema()
   - listaAnimales : ArrayList<Animal>
   - listaFamilias : ArrayList<Familia>
   - listaEmpresas : ArrayList<Empresa>
   - listaAdopciones : ArrayList<Adopcion>
   - listaDonaciones : ArrayList<Donacion>
   + datosRefugio() : int[]
   + animalesAdoptables() : ArrayList<Animal>
   + agregarAnimal(Animal) : void
   + agregarFamilia(Familia) : void
   + agregarEmpresa(Empresa) : void
   + agregarAdopcion(Adopcion) : void
   + agregarDonacion(Donacion) : void
   + anularAdopcion(Adopcion) : void
   + getEmpresaPorRut(String) : Empresa
   + notificarObs() : void
   + ordenarFam(boolean) : void
   + noEntregados() : ArrayList<Animal>
   + famConAdops() : ArrayList<String>
}

class OrdPorAdops {
   + compare(Familia, Familia) : int
}

class Animal {
   + Animal(String, String, String, int, String)
   - nombre : String
   - codigo : String
   - temperamento : String
   - peso : int
   - estado : String
   + cambiarEstado() : void
}

class Familia {
   + Familia(String, String, String)
   - cedulaTitular : String
   - apellido : String
   - celular : String
}

class Empresa {
   + Empresa(String, String, String)
   - nombre : String
   - rut : String
   - direccion : String
}

class Adopcion {
   + Adopcion(Animal, Familia, String)
   - animal : Animal
   - familia : Familia
   - comentarios : String
   - numero : int
   - {static} ultNumero: int
}

class Donacion {
   + Donacion(Empresa, int, int, int)
   - empresaDonante : Empresa
   - tipoAlimento : int
   - kilos : int
   - codigo : int
}

Animal --o Sistema
Familia --o Sistema
Empresa --o Sistema
Adopcion --o Sistema
Donacion --o Sistema
Adopcion --> Animal
Adopcion --> Familia
Donacion --> Empresa
OrdPorAdops --* Sistema
@enduml
