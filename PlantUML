@startuml
class Sistema {
   + Sistema()
   - listaAnimales : ArrayList<Animal>
   - listaFamilias : ArrayList<Familia>
   - listaEmpresas : ArrayList<Empresa>
   - listaAdopciones : ArrayList<Adopcion>
   - listaDonaciones : ArrayList<Donacion>
   + registrarAnimal(Animal) : void
   + registrarFamilia(Familia) : void
   + registrarEmpresa(Empresa) : void
   + registrarAdopcion(Adopcion) : void
   + registrarDonacion(Donacion) : void
   + anularAdopcion(Adopcion) : void
   + importarDonaciones() : void
}

class Animal {
   + Animal(String, String, String, int, String)
   - nombre : String
   - codigo : String
   - temperamento : String
   - peso : int
   - estado : String
   + cambiarEstado() : void
}

class Familia {
   + Familia(String, String, String)
   - cedulaTitular : String
   - apellido : String
   - celular : String
}

class Empresa {
   + Empresa(String, String, String)
   - nombre : String
   - rut : String
   - direccion : String
}

class Adopcion {
   + Adopcion(Animal, Familia, String)
   - animal : Animal
   - familia : Familia
   - comentarios : String
}

class Donacion {
   + Donacion(Empresa, int, int, int)
   - empresaDonante : Empresa
   - tipoAlimento : int
   - kilos : int
   - codigo : int
}

Animal --o Sistema
Familia --o Sistema
Empresa --o Sistema
Adopcion --o Sistema
Donacion --o Sistema
Adopcion --> Animal
Adopcion --> Familia
Donacion --> Empresa
@enduml
